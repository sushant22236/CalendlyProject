// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventTypes             EventType[] // One-to-many relationship with EventType
  availabilityRules      AvailabilityRule[] // One-to-many relationship with AvailabilityRule
  availabilityExceptions AvailabilityExceptions[] // One-to-many relationship with AvailabilityExceptions

  @@map("users") // Maps this model to the "users" table in the database
}

model EventType {
  id                  Int      @id @default(autoincrement())
  hostId              Int
  title               String
  description         String?
  slug                String
  durationMinutes     Int
  isActive            Boolean  @default(true)
  locationType        String   @default("online") // Default value set to "online"
  locationValue       String?
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade) // Many-to-one relationship with User

  @@unique([hostId, slug]) // Ensures that the combination of hostId and slug is unique
  @@map("event_types") // Maps this model to the "event_types" table in the database
}

model AvailabilityRule {
  id        Int      @id @default(autoincrement())
  userId    Int
  dayOfWeek Int // 0-6 (Sunday-Saturday)
  startTime String // "09:00" format
  endTime   String // "17:00" format
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek]) // Ensures that the combination of userId and dayOfWeek is unique
  @@map("availability_rules")
}

model AvailabilityExceptions {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @db.Date
  type      String // "block" or "available"
  startTime String? // "09:00" format
  endTime   String? // "17:00" format
  timezone  String   @default("UTC")
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date]) // Ensures that the combination of userId and date is unique
  @@map("availability_exceptions")
}
